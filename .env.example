# Copie para .env (que NÃO é versionado). Nunca commite credenciais de produção.

# Mesma URL para homologação e produção: o ambiente é definido pelas credenciais.
VIPP_BASE_URL=https://vpsrv.visualset.com.br

# Credenciais PÚBLICAS de homologação, publicadas no PDF do ViPP.
# As de produção são fornecidas pela AGF.
VIPP_USUARIO=onbiws
VIPP_TOKEN=112233
VIPP_ID_PERFIL=9363

VIPP_TIMEOUT=30
VIPP_VALIDAR_ANTES_DE_ENVIAR=true

# Testes de integração (tests/Integration): criam postagens reais. Só rodam com 1.
VIPP_RUN_INTEGRATION=0
