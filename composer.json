{
    "name": "marcelofecchio/vipp-php-sdk",
    "description": "SDK PHP 8.4 para o Web Service de Postagem do ViPP (VisualSet), com integração opcional ao Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "vipp",
        "visualset",
        "correios",
        "agf",
        "postagem",
        "etiqueta",
        "declaracao de conteudo",
        "laravel",
        "sdk"
    ],
    "authors": [
        {
            "name": "Marcelo Fecchio",
            "homepage": "https://github.com/marcelofecchio"
        }
    ],
    "support": {
        "issues": "https://github.com/marcelofecchio/vipp-php-sdk/issues",
        "source": "https://github.com/marcelofecchio/vipp-php-sdk",
        "docs": "https://github.com/marcelofecchio/vipp-php-sdk#readme"
    },
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Cliente HTTP PSR-18 padrão (já incluído no Laravel); permite configurar o timeout.",
        "laravel/framework": "Integração automática: Service Provider, config/vipp.php e Facade Vipp."
    },
    "autoload": {
        "psr-4": {
            "MarceloFecchio\\Vipp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarceloFecchio\\Vipp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MarceloFecchio\\Vipp\\Laravel\\VippServiceProvider"
            ],
            "aliases": {
                "Vipp": "MarceloFecchio\\Vipp\\Laravel\\Facades\\Vipp"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest --exclude-group=integration",
        "test:integration": "pest --group=integration",
        "test:coverage": "pest --exclude-group=integration --coverage",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "qa": [
            "@cs:check",
            "@analyse",
            "@test"
        ]
    }
}
